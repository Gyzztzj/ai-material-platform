# Docker Compose 环境变量配置
# 用于本地Docker部署

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai-material-db

# 后端服务配置
PORT=3000
DATABASE_SSL=false
JWT_SECRET=your-docker-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# AI API 配置
TONGYI_API_KEY=your-tongyi-api-key-here
DOUBAI_API_KEY=your-doubao-api-key-here
REMOVE_BG_API_KEY=your-remove-bg-api-key-here

# Redis配置（使用Docker内部网络，不需要密码）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 日志配置
LOG_LEVEL=info
NODE_ENV=production

# 前端 API 配置（使用 nginx 反向代理）
VITE_API_URL=/api
