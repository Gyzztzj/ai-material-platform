{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm build",
    "outputDirectory": "dist"
  },
  "deploy": {
    "static": {
      "directory": "dist",
      "publishDirectory": "dist"
    },
    "healthcheckPath": "/"
  }
}
