{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ai-material && pnpm install && pnpm build",
    "outputDirectory": "ai-material/dist"
  },
  "deploy": {
    "static": {
      "directory": "ai-material/dist",
      "publishDirectory": "ai-material/dist"
    },
    "healthcheckPath": "/"
  }
}
