
# 服务端口
PORT=3000

# 日志配置
LOG_LEVEL=info
LOG_DIR=logs

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai-material-db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai-material-db
DATABASE_SSL=false

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=mo-xiu-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI API配置
# 通义万相 (阿里云DashScope API Key
TONGYI_API_KEY=your_tongyi_api_key_here
# 豆包火山引擎 API Key
DOUBAI_API_KEY=your_doubao_api_key_here
# 抠图API Key (可选)
REMOVE_BG_API_KEY=your_remove_bg_api_key_here